{
  "name": "opencode-zmllmgw",
  "version": "0.0.2",
  "description": "OpenCode AI SDK provider for the ZMLLMGW model gateway",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
